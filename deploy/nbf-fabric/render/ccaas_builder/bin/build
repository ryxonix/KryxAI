#!/bin/bash
# ccaas external builder — copy connection.json into the build output.
# Invoked by the peer as:  build CHAINCODE_SOURCE_DIR CHAINCODE_METADATA_DIR BUILD_OUTPUT_DIR
set -euo pipefail

SOURCE_DIR="${1:-${CHAINCODE_SOURCE_DIR}}"
BUILD_OUTPUT_DIR="${3:-${CHAINCODE_BUILD_OUTPUT_DIR}}"

mkdir -p "${BUILD_OUTPUT_DIR}"
cp "${SOURCE_DIR}/connection.json" "${BUILD_OUTPUT_DIR}/connection.json"