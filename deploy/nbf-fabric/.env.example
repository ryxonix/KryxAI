# KryxAI NBF gateway — environment (copy to gateway/.env or export)
# For the official NBFLite swap (zero-cost), see docs/nbflite-swap.md.
GATEWAY_PORT=4000
IPFS_API_HOST=127.0.0.1
IPFS_API_PORT=5001
IPFS_GATEWAY=http://127.0.0.1:8080
# Fabric connection profile for org1 (generated by the deploy scripts)
CCP_FILE=./connection-org1.json
WALLET_DIR=./gateway/wallet
# Backend side: NBF_IPFS_MODE=auto (see backend/.env.example) — not read here.