# KryxAI configuration. Copy to `.env` and edit. Every key is also settable as
# an environment variable. Defaults are shown; uncomment only what you change.

# ── Evidence chain ──────────────────────────────────────────────────────────
# Proof-of-work difficulty for the local evidence ledger. Stored per block and
# re-verified against the stored value, never recomputed.
KRYXAI_BLOCKCHAIN_DIFFICULTY=4

# External anchoring (Hyperledger Fabric + IPFS).
#
# ANCHOR_REQUIRED is false by default on purpose. A fail-closed default means
# every report endpoint returns 503 on any machine without a running Fabric
# network. The permissive default is never dishonest: an unanchored report is
# labelled `pending` or `demo`, never `anchored`.
KRYXAI_BLOCKCHAIN_EXTERNAL_ANCHOR=false
KRYXAI_BLOCKCHAIN_ANCHOR_REQUIRED=false

KRYXAI_NBF_GATEWAY_URL=http://127.0.0.1:4000
KRYXAI_NBF_CHANNEL=mychannel
KRYXAI_NBF_CC=kryxai-posture
KRYXAI_NBF_USER=User1
KRYXAI_NBF_MSP=Org1MSP
KRYXAI_NBF_CFGPATH=
KRYXAI_NBF_IPFS_MODE=auto
KRYXAI_IPFS_STORE_URL=
KRYXAI_IPFS_API_PORT=5001
KRYXAI_IPFS_GATEWAY_PORT=8080
KRYXAI_NBF_TIMEOUT_S=20

# ── Storage and reports ─────────────────────────────────────────────────────
# KRYXAI_DATABASE_PATH=./kryxai.db
# KRYXAI_REPORTS_DIR=./reports
# KRYXAI_REPORT_KEYS_DIR=./reports/keys

# Path to a Devanagari-capable .ttf (e.g. NotoSansDevanagari-Regular.ttf).
# A default Windows install ships no Devanagari font, and a PDF cannot render
# Devanagari without one. When unset and none is found, the PDF is English-only
# and states that Hindi text was omitted rather than emitting blank glyphs.
# The HTML and JSON reports are always fully bilingual.
# KRYXAI_DEVANAGARI_FONT_PATH=

# ── Analysis ────────────────────────────────────────────────────────────────
# Certificate validity is always judged against capture time, not analysis
# time. This is not configurable to anything else.
KRYXAI_EXPIRY_REFERENCE=capture_time

# Optional learned risk model. Absent by default; the rule-based score is the
# validated path and a missing model never fails a scan.
# KRYXAI_ONNX_MODEL_PATH=

# ── Threat intelligence ─────────────────────────────────────────────────────
# There is no verified machine-readable CERT-In IoC API. `bundle` makes no
# network call and reads only operator-supplied files from KRYXAI_IOC_FEED_DIR;
# every feed records its own provenance and is marked unverified unless the feed
# file says otherwise.
KRYXAI_IOC_FEED_MODE=bundle
# KRYXAI_IOC_FEED_URL=
# KRYXAI_IOC_FEED_DIR=./kryxai/data/feeds

# ── Alerting (all optional; unconfigured channels are skipped, never fatal) ─
# Alerting is the only outbound network call KryxAI makes; it is passive
# otherwise. With no channel configured below, no request is ever sent.
#
# Delivery is best-effort and never affects the scan result, but a failure is
# recorded in the report's `alerts` section, so an unnotified scan is never
# mistaken for a notified one.
#
# KRYXAI_ALERTS_ENABLED=true
# A finding at or above this severity notifies. "info" is present in every
# scan, so alerting on it would page you for a clean capture.
# KRYXAI_ALERT_MIN_SEVERITY=high
# Per-attempt socket timeout. Worst case a scan spends
# channels x (KRYXAI_MAX_ALERT_RETRIES + 1) x this on delivery.
# KRYXAI_ALERT_TIMEOUT_S=5
# KRYXAI_TELEGRAM_BOT_TOKEN=
# KRYXAI_TELEGRAM_CHAT_ID=
# KRYXAI_SMTP_HOST=
# KRYXAI_SMTP_PORT=587
# KRYXAI_SMTP_USER=
# KRYXAI_SMTP_PASSWORD=
# KRYXAI_ALERT_EMAIL_TO=
# KRYXAI_NTFY_TOPIC=
# KRYXAI_NTFY_SERVER=https://ntfy.sh
# KRYXAI_WEBHOOK_URL=
# KRYXAI_MAX_ALERT_RETRIES=3

# ── Server ──────────────────────────────────────────────────────────────────
KRYXAI_HOST=0.0.0.0
KRYXAI_PORT=8000
