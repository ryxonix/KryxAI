# Python build / packaging
build/
dist/
*.egg-info/
*.egg
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# KryxAI runtime state — see the "Where data is written" section of README.md.
# The signing key in particular must never be committed.
kryxai.db
kryxai.db-journal
reports/
.smoke/
*.pem
.keys/

# Generated by `kryxai corpus`: synthetic, and reproducible on demand.
corpus/

# Same generator, written here by the browser acceptance run. Nothing in the
# code, tests or docs reads this path, so it is an output, not a fixture.
demo_captures/

# Trained model artefacts. These are build outputs of training/kryxai_train.ipynb,
# not source. They are deliberately NOT committed, so a wheel built from a clean
# checkout is rules-only and every user's risk scores come from the validated
# rule engine. The model does not outperform the rules, so shipping it by default
# would silently change results for anyone who installed the package without
# asking for it. Opt in by running training/export/install_model.py and rebuilding
# the wheel deliberately; pyproject package-data carries both files when present.
kryxai/scoring/risk_model.onnx
kryxai/scoring/model_card.json
training/data/
*.onnx

# Local configuration
.env

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Fabric deployment material. crypto-config/ is generated per-deployment and
# contains key material — regenerate it, never commit it.
deploy/nbf-fabric/crypto-config/
deploy/nbf-fabric/gateway/node_modules/
*.block
*.tx

# Local `go build` output from deploy/nbf-fabric/go/. The deployment compiles
# this inside Docker (see render/ccaas_builder), so a committed Windows binary
# would be both stale and the wrong platform.
deploy/nbf-fabric/go/*.exe

# OS noise
.DS_Store
Thumbs.db
